# Plantilla de variables de entorno — este archivo SI se sube a Git
# Copielo como .env y complete los valores de su propio equipo
PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=qr_empresarial
DB_PORT=3306

# Autenticacion con JWT
# Genere su propio secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Recuperacion de contrasena
# APP_URL es la direccion publica del frontend que recibe el enlace
APP_URL=http://localhost:3000
RECUPERACION_EXPIRA_MINUTOS=30

# Envio de correo (RF-03)
# Si se dejan vacias y NODE_ENV no es production, el backend crea una cuenta
# de prueba en Ethereal al arrancar: el correo no llega a ningun destinatario
# real, pero queda visible en una URL que se imprime en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=QR Empresarial <no-responder@qrempresarial.co>
