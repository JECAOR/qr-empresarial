        {
          "name": "00 Health check (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/health",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Comprobacion de la Guia 1: Node ejecuta el proyecto, Express escucha y la API responde."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
