# Variables para la prueba del doble paso de StrictMode, que solo ocurre en
# desarrollo. Vite las aplica al arrancar con --mode e2e-dev, que es lo que
# hace el segundo servidor de playwright.config.js.
#
# Es .env.e2e con otro puerto: el del servidor de desarrollo. Las razones de
# apuntar la API al propio servidor son las mismas que allí.
VITE_API_URL=http://localhost:5174/api

VITE_SLUG_DEMO=panaderia-la-espiga
