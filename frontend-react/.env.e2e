# Variables para las pruebas de extremo a extremo. Vite las aplica al
# compilar con --mode e2e, que es lo que hace playwright.config.js.
#
# La direccion apunta al propio servidor de las pruebas y no al backend de
# desarrollo (:3000) a proposito, por dos razones:
#
#   - Es el mismo origen, asi que no hay CORS que configurar en cada
#     respuesta simulada ni peticiones OPTIONS de verificacion previa.
#   - Si una peticion se escapa sin simular, cae en el servidor de las
#     pruebas y falla al convertir el HTML a JSON. Con :3000 le pegaria al
#     backend de verdad y dejaria la base de datos tocada.
VITE_API_URL=http://localhost:4174/api

VITE_SLUG_DEMO=panaderia-la-espiga
