# Variables publicas del frontend. Vite solo expone al navegador las que
# empiezan por VITE_, asi que aqui NUNCA van contrasenas, JWT_SECRET ni
# credenciales de MySQL: cualquiera que abra la aplicacion puede leerlas.
#
# Copie este archivo como .env. Despues de modificarlo hay que reiniciar Vite.

VITE_API_URL=http://localhost:3000/api

# El perfil que se consulta al abrir la pantalla. Es el que siembra
# database/seed.sql; desde la pantalla se puede consultar cualquier otro.
VITE_SLUG_DEMO=panaderia-la-espiga
