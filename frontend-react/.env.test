# Variables para las pruebas. Vite carga este archivo cuando el modo es
# "test", que es el que usa Vitest.
#
# La direccion es inventada a proposito: ninguna prueba debe llegar a la red.
# Si una se escapa, el fetch falla con un error de DNS en lugar de pegarle al
# servidor de desarrollo y dejar la base de datos tocada.
VITE_API_URL=http://api.de.pruebas.invalido/api

VITE_SLUG_DEMO=panaderia-la-espiga
